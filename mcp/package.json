{
  "name": "characterbinder-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that lets coding agents build and edit CharacterBinder cards in the running app",
  "type": "module",
  "bin": {
    "characterbinder-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.2"
  }
}
