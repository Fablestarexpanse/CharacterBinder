{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  // One glob rather than a hand-maintained file list that goes stale: src/shared
  // is precisely the browser-neutral surface this package may import.
  "include": ["src/**/*.ts", "../src/shared/**/*.ts"]
}
