{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  // Every app-side file this package imports, so a change over there is a type
  // error here rather than a runtime surprise. Listing only some of them meant
  // the validator and the platform table were compiled blind.
  "include": [
    "src/**/*.ts",
    "../src/lib/bridge/protocol.ts",
    "../src/lib/personaParser.ts",
    "../src/lib/validators.ts",
    "../src/lib/platforms/index.ts"
  ]
}
